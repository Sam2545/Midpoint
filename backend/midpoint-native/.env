# Environment Variables for Midpoint Activity Finder
# This file is automatically loaded by Expo

# Backend API Configuration
# For web development (localhost)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api/places

# For mobile development, you'll need to replace localhost with your computer's IP
# Find your IP by running: ifconfig | grep "inet " | grep -v 127.0.0.1
# Then update the URL below with your actual IP address
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8080/api/places

# Google Maps API Key (for direct client-side usage if needed)
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Development settings
EXPO_PUBLIC_DEBUG=true
